/*********************************************************************
 * rsu_micro.dat  —  Datos de un MICRO-ejemplo (hecho a mano)
 *
 * 3 RSU candidatos (R1,R2,R3) + RSU artificial r_inf (id 0).
 * 2 escenarios (snapshots).  4 vehículos.  Hasta 2 saltos reales.
 *
 * Conectividad inventada (CVR):
 *   Escenario 1:  v1 ve R1 (1 salto); v2 llega a R1 (2 saltos) y ve R2 (1);
 *                 v3 ve R2 (1 salto) y llega a R1 (2 saltos).
 *   Escenario 2:  v1 ve R1 (1); v2 llega a R1 (2); v4 SOLO ve R3 (1).
 *
 * Como v4 solo se conecta vía R3, y v1/v2 vía R1, el óptimo con MaxR=2
 * debería elegir {R1, R3} para no dejar a nadie desconectado.
 *********************************************************************/

hmax = 3;          // saltos 1 y 2 para RSU reales; salto 3 = caer en r_inf
rInf = 0;
MaxR = 2;

R = { 0, 1, 2, 3 };          // 0 = r_inf (artificial)
S = { 1, 2 };                // dos escenarios
V = { 1, 2, 3, 4 };          // cuatro vehículos

// vehículos presentes en cada escenario
Vs = #[ 1 : {1, 2, 3},
        2 : {1, 2, 4} ]#;

// costos: r_inf gratis; cada RSU real cuesta 1 (así el modelo minimiza cantidad)
Cost = #[ 0:0, 1:1, 2:1, 3:1 ]#;

// capacidades: r_inf "infinita"; reales grandes (no es el cuello de botella aquí)
Cap = #[ 0:1000, 1:100, 2:100, 3:100 ]#;

// penalización por saltos: 1 salto barato, 2 saltos más caro, 3 (=desconexión) carísimo
P = [ 1, 2, 1000 ];

// carga de tráfico de cada vehículo (1 para todos, en ambos escenarios)
L = #[ 1 : #[ 1:1, 2:1, 3:1, 4:1 ]#,
       2 : #[ 1:1, 2:1, 3:1, 4:1 ]# ]#;

// ---- CVR: tuplas <s, h, v, r> ----
CVR = {
  // --- Escenario 1 ---
  <1, 1, 1, 1>,   // v1 -> R1 en 1 salto
  <1, 2, 2, 1>,   // v2 -> R1 en 2 saltos (rebotando)
  <1, 1, 2, 2>,   // v2 -> R2 en 1 salto
  <1, 1, 3, 2>,   // v3 -> R2 en 1 salto
  <1, 2, 3, 1>,   // v3 -> R1 en 2 saltos

  // --- Escenario 2 ---
  <2, 1, 1, 1>,   // v1 -> R1 en 1 salto
  <2, 2, 2, 1>,   // v2 -> R1 en 2 saltos
  <2, 1, 4, 3>,   // v4 -> R3 en 1 salto (¡única opción real de v4!)

  // --- r_inf (todos los vehículos pueden "desconectarse" a hmax saltos) ---
  <1, 3, 1, 0>, <1, 3, 2, 0>, <1, 3, 3, 0>,
  <2, 3, 1, 0>, <2, 3, 2, 0>, <2, 3, 4, 0>
};
